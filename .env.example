# .env 템플릿: 이 파일을 .env로 복사해 값을 채우세요. .env는 git에 올라가지 않습니다 (.gitignore)

# Google Gemini API Key (대본·콘티 기획, 사진 분석)
# 발급: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# 참고: 영상은 실물 사진·영상 + 로컬 Ken Burns(ffmpeg), 음성은 Edge-TTS → 별도 키 불필요. AI 이미지 생성은 쓰지 않음

# YouTube Data API v3 키 (쇼츠 레이더). 없으면 레이더는 dry-run
# 발급: Google Cloud Console > API 및 서비스 > YouTube Data API v3 사용 설정 > 사용자 인증 정보
YOUTUBE_API_KEY=your_youtube_api_key_here

# 쿠팡 파트너스 Open API (쇼핑 제휴 모드: 상품 검색·파트너스 링크). 없으면 직접 입력
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# 네이버 지역 검색 (사장님 모드: 상호명 → 업종·주소). NCP 콘솔 > NAVER API HUB 앱의 인증 정보
# (Client ID 10자 / Client Secret 40자. developers.naver.com 검색 API는 종료됨)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 외부 접속(터널·다른 기기) PIN 잠금. 비우면 외부 접속 차단 (로컬 PC 접속은 PIN 없음)
DASHBOARD_PIN=

# 모바일 고정 주소 (ngrok 무료 고정 도메인). 둘 다 있으면 scripts\watchdog.ps1이 ngrok으로 띄움,
# 없으면 Cloudflare 임시 터널(주소가 몇 시간마다 바뀜)
# 발급: https://dashboard.ngrok.com > Your Authtoken / Domains (예: something-name.ngrok-free.app)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
