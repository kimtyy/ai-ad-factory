# 비밀 정보 (API 키)
.env
.env.*
!.env.example
.streamlit/secrets.toml
# 유튜브 OAuth 클라이언트·토큰 (scripts/youtube_auth.py)
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 생성 산출물 / 대용량 미디어 (크롤링 사진, 업로드 원본, 렌더링 결과)
outputs/
scratch/
sessions/
storyboard_plan.json
*TEMP_MPY*
*.mp4
*.mov
*.mp3
*.wav
*.jpg
*.jpeg
*.png
*.webp

# 폰트는 실행 시 자동 다운로드 (core/compositor.py)
fonts/

# 테스트 픽스처 (tests/_support.py가 실행 시 생성)
tests/_fixtures/

# 자체 음원(BGM): 용량·권리 문제로 git에 올리지 않음 (폴더 안내 README만)
assets/bgm/*
!assets/bgm/README.md
# 배포(Streamlit Cloud)용 압축본 mp3는 올림 (원본 wav는 용량 때문에 제외)
!assets/bgm/*.mp3
!assets/bgm/moods.json

# 캘린더 자동 제작 사진 폴더 (사용자 사진)
inbox/

# 홈페이지(GitHub Pages) 배경·샘플 영상
!docs/hero-bg.mp4
